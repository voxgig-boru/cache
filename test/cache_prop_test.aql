# cache — prop_test suite.
#
# PLACEHOLDER. The library is designed but not implemented (see
# DESIGN.md), so there is nothing to assert yet. The file holds the
# naming convention and keeps CI green; add real cases alongside the
# first implemented word.
#
# Run:
#   boru test/cache_prop_test.aql

# The library is imported before boru:test — the order the sibling
# bloom-filter / stats suites need. On boru main @ 64c5ab2 boru:test mints
# its record types from a fresh type-ID counter, so a library class can
# collide with one of them and fail its own return-type check ("expected X,
# got X"); whether it does depends on the type ID the class lands on, not
# only on import order. See dx-report.md.
import "../cache.aql"
import "boru:test"

# --- summary -------------------------------------------------------

# One value per `print (…)` statement: a postfix `"x" print` chain collects
# forward and prints out of order.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
